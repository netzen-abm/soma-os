{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-os.org/schema/health-state-evidence-link-v1.json",
  "title": "SOMA Health State to Evidence Link v1",
  "description": "Directional, provenance-preserving link between a personal health-state entity and a general evidence entity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "health_state_ref", "evidence_ref", "relationship", "provenance"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "health_state_ref": {"type": "string", "minLength": 1},
    "evidence_ref": {"type": "string", "minLength": 1},
    "relationship": {"type": "string", "enum": ["EVIDENCE_INFORMS_INTERPRETATION", "EVIDENCE_INFORMS_HYPOTHESIS", "EVIDENCE_SUPPORTS_CONTEXTUAL_DECISION", "PERSONAL_RESPONSE_OBSERVED_AFTER_INTERVENTION"]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method"], "properties": {"method": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "actor_ref": {"type": "string", "minLength": 1}}},
    "context": {"type": "object", "additionalProperties": true},
    "uncertainty": {"type": "string", "enum": ["known", "estimated", "reported", "inferred", "missing", "conflicting", "not_applicable"]}
  }
}
