{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-os.org/schema/health-state-v1.json",
  "title": "SOMA Health State Entity v1",
  "description": "Canonical longitudinal health-state entity contract. This schema represents health information, not diagnosis or clinical truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject_ref", "entity_type", "schema_version", "status", "recorded_time", "provenance", "classification"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "entity_type": {"type": "string", "enum": ["person", "observation", "interpretation", "goal", "context", "intervention", "response", "outcome"]},
    "schema_version": {"const": "1.0.0"},
    "status": {"type": "string", "enum": ["active", "superseded", "withdrawn", "entered_in_error"]},
    "effective_time": {"type": "object", "additionalProperties": false, "properties": {"at": {"type": "string", "format": "date-time"}, "from": {"type": "string", "format": "date-time"}, "to": {"type": "string", "format": "date-time"}}, "minProperties": 1},
    "recorded_time": {"type": "string", "format": "date-time"},
    "concept": {"type": "string", "minLength": 1},
    "value": {},
    "unit": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["origin", "method"], "properties": {"origin": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "retrieved_at": {"type": "string", "format": "date-time"}, "span": {"type": "string", "minLength": 1}}},
    "classification": {"type": "string", "enum": ["personal_health", "sensitive_personal_health", "derived_health", "research_context"]},
    "uncertainty": {"type": "string", "enum": ["known", "estimated", "reported", "inferred", "missing", "conflicting", "not_applicable"]},
    "relationships": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "target_ref"], "properties": {"type": {"type": "string", "enum": ["HAS_OBSERVATION", "HAS_CONTEXT", "HAS_GOAL", "HAS_INTERVENTION", "HAS_RESPONSE", "HAS_OUTCOME", "DERIVED_FROM", "SUPPORTS_HYPOTHESIS", "REFUTES_HYPOTHESIS", "TEMPORALLY_PRECEDES", "ASSOCIATED_WITH", "MEASURED_BY", "EVIDENCE_LINKED"]}, "target_ref": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"entity_type": {"const": "observation"}}, "required": ["entity_type"]}, "then": {"required": ["concept", "uncertainty"]}},
    {"if": {"properties": {"entity_type": {"const": "interpretation"}}, "required": ["entity_type"]}, "then": {"required": ["relationships", "uncertainty"]}}
  ]
}
