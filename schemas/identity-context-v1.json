{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-os.org/schemas/identity-context-v1.json",
  "title": "SOMA IdentityContext v1",
  "description": "Canonical verified security and isolation context. authentication_status=VERIFIED means the security context was verified; it does not by itself mean real-world identity was verified. This contract carries security facts; it does not grant authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id",
    "schema_version",
    "principal_id",
    "principal_type",
    "identity_mode",
    "authentication_status",
    "authentication_provenance",
    "tenant_scope",
    "data_domain_scope",
    "assurance_level",
    "issued_at"
  ],
  "properties": {
    "context_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.1.0"},
    "principal_id": {"type": "string", "minLength": 1},
    "principal_type": {
      "type": "string",
      "enum": ["person", "agent", "service", "application", "device"]
    },
    "identity_mode": {
      "type": "string",
      "enum": ["anonymous_local", "authenticated_account"]
    },
    "authentication_status": {
      "type": "string",
      "enum": ["VERIFIED", "UNVERIFIED", "EXPIRED", "REVOKED"]
    },
    "authentication_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "method", "verified_at", "verifier_id"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"},
        "verifier_id": {"type": "string", "minLength": 1}
      }
    },
    "tenant_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "data_domain_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "jurisdiction_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assurance_level": {
      "type": "string",
      "enum": ["LOW", "SUBSTANTIAL", "HIGH"]
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
