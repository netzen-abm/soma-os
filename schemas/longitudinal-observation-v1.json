{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-os.org/schema/longitudinal-observation-v1.json",
  "title": "SOMA Longitudinal Observation v1",
  "description": "Canonical observation contract for longitudinal health data. An observation records a health-related fact or measurement and does not establish diagnosis, interpretation, or causation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject_ref", "entity_type", "schema_version", "status", "concept", "recorded_at", "provenance", "classification", "uncertainty"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "entity_type": {"const": "observation"},
    "schema_version": {"const": "1.0.0"},
    "status": {"type": "string", "enum": ["active", "superseded", "withdrawn", "entered_in_error"]},
    "concept": {"type": "string", "minLength": 1},
    "value": {},
    "unit": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "observed_from": {"type": "string", "format": "date-time"},
    "observed_to": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "source_ref": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "method"],
      "properties": {
        "origin": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "span": {"type": "string", "minLength": 1}
      }
    },
    "classification": {"type": "string", "enum": ["personal_health", "sensitive_personal_health", "derived_health", "research_context"]},
    "uncertainty": {"type": "string", "enum": ["known", "estimated", "reported", "inferred", "missing", "conflicting", "not_applicable"]},
    "data_quality": {"type": "string", "enum": ["high", "moderate", "low", "unknown"]},
    "device_ref": {"type": "string", "minLength": 1},
    "context_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target_ref"],
        "properties": {
          "type": {"type": "string", "enum": ["DERIVED_FROM", "HAS_CONTEXT", "TEMPORALLY_PRECEDES", "ASSOCIATED_WITH", "MEASURED_BY", "EVIDENCE_LINKED", "HAS_INTERVENTION", "HAS_RESPONSE", "HAS_OUTCOME"]},
          "target_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"required": ["observed_from"]},
      "then": {"required": ["observed_to"]}
    },
    {
      "if": {"required": ["observed_to"]},
      "then": {"required": ["observed_from"]}
    }
  ]
}
