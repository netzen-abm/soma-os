{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-os.org/schema/cross-paradigm-evidence-v1.json",
  "title": "SOMA Cross-Paradigm Evidence Assessment v1",
  "description": "Provider-neutral, paradigm-aware evidence assessment contract. It separates knowledge-system context and research method from evidence strength and preserves safety, contradiction, applicability, uncertainty and provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "claim_ref",
    "knowledge_system",
    "claim_type",
    "research_method",
    "evidence_assessment",
    "safety_assessment",
    "applicability",
    "provenance"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "claim_ref": {"type": "string", "minLength": 1},
    "knowledge_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_id", "system_class"],
      "properties": {
        "system_id": {"type": "string", "minLength": 1},
        "system_class": {"type": "string", "enum": ["biomedical", "traditional", "complementary", "integrative", "emerging", "other"]},
        "epistemology": {"type": "string", "minLength": 1},
        "diagnostic_model": {"type": "string", "minLength": 1},
        "intervention_model": {"type": "string", "minLength": 1},
        "outcome_model": {"type": "string", "minLength": 1}
      }
    },
    "claim_type": {"type": "string", "enum": ["phenomenological", "empirical_relationship", "causal", "ontological_theoretical"]},
    "research_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "design": {"type": "string", "minLength": 1},
        "evidence_framework": {"type": "string", "minLength": 1},
        "prospective": {"type": "boolean"},
        "controlled": {"type": "boolean"},
        "randomized": {"type": "boolean"},
        "blinded": {"type": "boolean"},
        "sample_size": {"type": "integer", "minimum": 0},
        "attrition_count": {"type": "integer", "minimum": 0},
        "negative_outcomes_reported": {"type": "boolean"}
      }
    },
    "evidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_level", "causal_inference", "uncertainty"],
      "properties": {
        "evidence_level": {"type": "string", "enum": ["E0_UNKNOWN", "E1_PLAUSIBLE", "E2_PRELIMINARY", "E3_SUPPORTED", "E4_WELL_SUPPORTED"]},
        "causal_inference": {"type": "string", "enum": ["not_assessed", "descriptive_only", "associational", "limited_causal", "strong_causal"]},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observation": {"type": "string"},
            "measurement": {"type": "string"},
            "internal_validity": {"type": "string"},
            "causal_inference": {"type": "string"},
            "external_validity": {"type": "string"},
            "replication": {"type": "string"},
            "mechanism": {"type": "string"},
            "longitudinal_evidence": {"type": "string"},
            "individualization": {"type": "string"},
            "negative_evidence": {"type": "string"},
            "independent_evidence": {"type": "string"},
            "paradigm_coherence": {"type": "string"},
            "cross_paradigm_convergence": {"type": "string"}
          }
        },
        "confounders": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "contradictory_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "safety_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": {
        "classification": {"type": "string", "enum": ["LOW_CONCERN", "CONTEXT_DEPENDENT", "CLINICALLY_SIGNIFICANT_CAUTION", "CONTRAINDICATED", "INSUFFICIENT_SAFETY_EVIDENCE"]},
        "findings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population_context"],
      "properties": {
        "population_context": {"type": "string", "minLength": 1},
        "context_limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "method", "assessment_record"],
      "properties": {
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "method": {"type": "string", "minLength": 1},
        "assessment_record": {"type": "string", "minLength": 1},
        "reviewer_ref": {"type": "string", "minLength": 1},
        "transformation_history": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"claim_type": {"const": "causal"}}, "required": ["claim_type"]},
      "then": {
        "properties": {
          "evidence_assessment": {
            "properties": {
              "causal_inference": {"enum": ["limited_causal", "strong_causal"]}
            }
          }
        }
      }
    }
  ]
}
