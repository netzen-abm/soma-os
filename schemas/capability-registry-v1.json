{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-os.org/schema/capability-registry-v1.json",
  "title": "SOMA Capability Registry v1",
  "description": "Canonical provider-neutral registry of reusable SOMA capability identities and governance metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "domain", "status", "maturity", "principal_types", "identity_requirements", "policy", "adapters", "surfaces"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
          "version": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "enum": ["privacy", "security", "data", "provenance", "evidence", "spatial", "knowledge", "intelligence", "transport", "infrastructure", "research"]},
          "status": {"type": "string", "enum": ["proposed", "experimental", "validated", "implemented", "architecture", "adapter-boundary", "optional", "planned"]},
          "maturity": {"type": "string", "enum": ["development", "validated", "production", "planned"]},
          "principal_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "identity_requirements": {
            "type": "object",
            "additionalProperties": false,
            "required": ["applies_to_principal_types", "allowed_identity_modes", "minimum_assurance_level", "requires_durable_identity"],
            "properties": {
              "applies_to_principal_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "allowed_identity_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["anonymous_local", "authenticated_account"]}},
              "minimum_assurance_level": {"type": "string", "enum": ["LOW", "SUBSTANTIAL", "HIGH"]},
              "requires_durable_identity": {"type": "boolean"}
            }
          },
          "policy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "adapters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "surfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
