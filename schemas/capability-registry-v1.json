{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-os.org/schemas/capability-registry-v1.json",
  "title": "SOMA Capability Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "capabilities": {
      "type": "array",
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version", "status", "maturity", "principal_types", "identity_requirements"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "maturity": {"type": "string", "minLength": 1},
        "principal_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "identity_requirements": {"$ref": "#/$defs/identity_requirements"}
      }
    },
    "identity_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_identity_modes", "minimum_assurance_level", "requires_durable_identity"],
      "properties": {
        "allowed_identity_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["anonymous_local", "authenticated_account"]}
        },
        "minimum_assurance_level": {
          "enum": ["LOW", "SUBSTANTIAL", "HIGH"]
        },
        "requires_durable_identity": {"type": "boolean"}
      }
    }
  }
}
