{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-os.org/schema/governed-capability-operation-v1.json",
  "title": "SOMA Governed Capability Operation v1",
  "description": "Provider-neutral operation envelope composing SOMA identity, capability, policy, protected-data, execution, result, provenance, and audit references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "schema_version", "status", "principal_ref", "identity_context_ref", "capability_id", "capability_version", "action", "resource_type", "purpose", "requested_at"],
  "properties": {
    "operation_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "status": {"type": "string", "enum": ["REQUESTED", "AUTHORIZING", "DENIED", "REQUIRES_CONSENT", "REQUIRES_HUMAN_REVIEW", "AUTHORIZED", "EXECUTING", "SUCCEEDED", "FAILED", "DEGRADED", "CANCELLED", "EXPIRED"]},
    "principal_ref": {"type": "string", "minLength": 1},
    "identity_context_ref": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "capability_version": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "resource_type": {"type": "string", "minLength": 1},
    "resource_ref": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "requested_data_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["decision", "policy_version", "decision_ref"], "properties": {"decision": {"type": "string", "enum": ["ALLOW", "DENY", "REQUIRE_CONSENT", "REQUIRE_HUMAN_REVIEW", "DEGRADE"]}, "policy_version": {"type": "string", "minLength": 1}, "decision_ref": {"type": "string", "minLength": 1}}},
    "consent": {"type": "object", "additionalProperties": false, "required": ["required", "status"], "properties": {"required": {"type": "boolean"}, "status": {"type": "string", "enum": ["not_required", "pending", "granted", "denied", "expired"]}, "consent_ref": {"type": "string", "minLength": 1}}},
    "human_review": {"type": "object", "additionalProperties": false, "required": ["required", "status"], "properties": {"required": {"type": "boolean"}, "status": {"type": "string", "enum": ["not_required", "pending", "approved", "rejected", "expired"]}, "review_ref": {"type": "string", "minLength": 1}}},
    "execution": {"type": "object", "additionalProperties": false, "properties": {"executor_ref": {"type": "string", "minLength": 1}, "runtime_ref": {"type": "string", "minLength": 1}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "failure_code": {"type": "string", "minLength": 1}, "failure_class": {"type": "string", "minLength": 1}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"type": "string", "enum": ["not_available", "success", "failure", "partial", "degraded"]}, "result_ref": {"type": "string", "minLength": 1}, "digest": {"type": "string", "minLength": 1}}},
    "provenance_ref": {"type": "string", "minLength": 1},
    "audit_ref": {"type": "string", "minLength": 1},
    "requested_at": {"type": "string", "format": "date-time"},
    "authorized_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
