{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-os.org/schemas/canonical-health-claim.schema.json",
  "title": "SOMA Canonical Health Evidence Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim",
    "knowledge_class",
    "evidence_status",
    "sources",
    "safety",
    "review"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^SOMA-[A-Z0-9-]+$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_class": {
      "type": "string",
      "enum": [
        "TRADITIONAL_KNOWLEDGE",
        "RESEARCH_FINDING",
        "CLINICAL_GUIDANCE",
        "MANAGEMENT_INFORMATION",
        "MECHANISTIC_HYPOTHESIS",
        "DATASET_FACT",
        "EXPERT_EDUCATION"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "UNREVIEWED",
        "SOURCE_FOUND",
        "SOURCE_VERIFIED",
        "EVIDENCE_ASSESSED",
        "SAFETY_REVIEWED",
        "PUBLISHED",
        "WITHDRAWN"
      ]
    },
    "evidence_level": {
      "type": ["string", "null"],
      "enum": [
        null,
        "NOT_ASSESSED",
        "VERY_LOW",
        "LOW",
        "MODERATE",
        "HIGH"
      ]
    },
    "population_context": {
      "type": ["string", "null"]
    },
    "intervention_or_exposure": {
      "type": ["string", "null"]
    },
    "outcome": {
      "type": ["string", "null"]
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "uncertainty": {
      "type": "array",
      "items": {"type": "string"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "management_boundary": {
      "type": "string",
      "enum": [
        "INFORMATION_ONLY",
        "MANAGEMENT_SUPPORT",
        "CLINICIAN_GUIDED"
      ]
    },
    "prohibited_claims": {
      "type": "array",
      "items": {"type": "string"}
    },
    "review": {
      "$ref": "#/$defs/review"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "title",
        "verification_url"
      ],
      "properties": {
        "source_id": {"type": "string"},
        "source_type": {
          "type": "string",
          "enum": [
            "GOVERNMENT",
            "REGULATORY",
            "SYSTEMATIC_REVIEW",
            "META_ANALYSIS",
            "CONTROLLED_STUDY",
            "OBSERVATIONAL_STUDY",
            "MECHANISTIC_STUDY",
            "TRADITIONAL_SOURCE",
            "CLINICAL_GUIDANCE",
            "OPEN_DATASET",
            "EXPERT_EDUCATION"
          ]
        },
        "title": {"type": "string"},
        "publisher": {"type": ["string", "null"]},
        "publication_date": {"type": ["string", "null"]},
        "verification_url": {"type": "string", "format": "uri"},
        "source_summary": {"type": ["string", "null"]}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "interaction_notes",
        "professional_review_required"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_ASSESSED",
            "REVIEWED",
            "SAFETY_CONCERN",
            "CONTRAINDICATION_IDENTIFIED"
          ]
        },
        "interaction_notes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "professional_review_required": {"type": "boolean"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_state",
        "last_verified"
      ],
      "properties": {
        "review_state": {
          "type": "string",
          "enum": [
            "UNREVIEWED",
            "SOURCE_FOUND",
            "SOURCE_VERIFIED",
            "EVIDENCE_ASSESSED",
            "SAFETY_REVIEWED",
            "PUBLISHED",
            "WITHDRAWN"
          ]
        },
        "reviewer": {"type": ["string", "null"]},
        "last_verified": {"type": "string", "format": "date"}
      }
    }
  }
}
